body {
  width: 100%;
  height: 100%;
  font-family: LatoLatin;
  font-size: 16dp;
  color: #f5f7fa;
  background: #1d2430;
}

/* RmlUi has no browser stylesheet: div defaults to inline. */
div {
  display: block;
}

#window {
  width: 480dp;
  height: 360dp;
  margin: auto;
  padding: 24dp;
  box-sizing: border-box;
  background: #2b3446;
  border: 1dp #46546e;
  border-radius: 10dp;
}

#title {
  font-size: 22dp;
  font-weight: bold;
  margin-bottom: 12dp;
  filter: drop-shadow(#000000 3dp 3dp 2dp);
}

#counter {
  font-size: 16dp;
  margin-bottom: 18dp;
  color: #8fd3ff;
}

button {
  display: inline-block;
  width: 160dp;
  height: 38dp;
  line-height: 38dp;
  text-align: center;
  font-size: 15dp;
  color: #ffffff;
  background: #e84c88;
  border-radius: 6dp;
  box-shadow: 4dp 4dp 8dp #00000080;
}

button:hover {
  background: #ff6aa2;
}

#blurred {
  margin-top: 22dp;
  padding: 14dp;
  width: 300dp;
  background: #3a475f;
  border-radius: 8dp;
  filter: blur(2dp);
}

#clipped {
  margin-top: 16dp;
  width: 300dp;
  height: 64dp;
  overflow: hidden;
  border-radius: 12dp;
  background: #1d2430;
}

#clipped .wide {
  width: 460dp;
  padding: 18dp;
  color: #ffd166;
}
