+// sfml.js extension: opaque provenance for native key and text events.
+// Public SFML event and window layouts remain unchanged.
+
+#pragma once
+
+#include <SFML/Window/Export.hpp>
+#include <SFML/Window/WindowHandle.hpp>
+
+#include "window-input-scope.h"
+
+#include <memory>
+#include <utility>
+
+extern "C" SFML_WINDOW_API void sfmljsSetEventSource(const void* source);
+extern "C" SFML_WINDOW_API void sfmljsTakeEventSource(void* source);
+extern "C" SFML_WINDOW_API bool sfmljsRegisterWindowInput(
+    uintptr_t handle, const sfmljs::interop::WindowInputCallbacks* callbacks);
+
+namespace sfmljs_backend
+{
+std::shared_ptr<void>& currentEventSource();
+sfmljs::interop::detail::WindowInputRegistry& windowInputs();
+
+inline uintptr_t windowInputHandle(sf::WindowHandle handle)
+{
+#if defined(SFML_SYSTEM_WINDOWS) || defined(SFML_SYSTEM_MACOS)
+    return reinterpret_cast<uintptr_t>(handle);
+#else
+    return static_cast<uintptr_t>(handle);
+#endif
+}
+
+// Responder delivery may nest. Restore the outer capture on every return.
+class EventSourceScope
+{
+public:
+    EventSourceScope() : m_previous(std::move(currentEventSource()))
+    {
+    }
+
+    ~EventSourceScope()
+    {
+        currentEventSource() = std::move(m_previous);
+    }
+
+    EventSourceScope(const EventSourceScope&) = delete;
+    EventSourceScope& operator=(const EventSourceScope&) = delete;
+
+private:
+    std::shared_ptr<void> m_previous;
+};
+} // namespace sfmljs_backend
