+sfmljs::interop::detail::WindowInputRegistry& windowInputs()
+{
+    static thread_local sfmljs::interop::detail::WindowInputRegistry registry;
+    return registry;
+}
+
+std::shared_ptr<void>& currentEventSource()
+{
+    static thread_local std::shared_ptr<void> source;
+    return source;
+}
+
+std::shared_ptr<void>& poppedEventSource()
+{
+    static thread_local std::shared_ptr<void> source;
+    return source;
+}
+} // namespace sfmljs_backend
+
+extern "C" SFML_WINDOW_API void sfmljsSetEventSource(const void* source)
+{
+    sfmljs_backend::currentEventSource() = *static_cast<const std::shared_ptr<void>*>(source);
+}
+
+extern "C" SFML_WINDOW_API void sfmljsTakeEventSource(void* source)
+{
+    *static_cast<std::shared_ptr<void>*>(source) = std::move(sfmljs_backend::poppedEventSource());
+}
+
+extern "C" SFML_WINDOW_API bool sfmljsRegisterWindowInput(
+    uintptr_t handle, const sfmljs::interop::WindowInputCallbacks* callbacks)
+{
+    return sfmljs_backend::windowInputs().Attach(handle, callbacks);
+}
 
