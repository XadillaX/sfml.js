+// AppKit obtains the active input context from the first responder, which
+// remains this SFML view. Expose the installed client's context so the system
+// input method sends composition callbacks to that same client.
+- (NSTextInputContext*)inputContext
+{
+    NSResponder* responder = [self nextResponder];
+    if ([responder respondsToSelector:@selector(sfmljsOwnsTextInputEvent:)])
+        if (NSTextInputContext* context = [responder inputContext])
+            return context;
+    return [super inputContext];
+}
